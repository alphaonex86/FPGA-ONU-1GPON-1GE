+ )
Ed dp dp1 dp0 0 0.5
Ed2 dp1 0 vb 0 1
En dn dn1 dp0 0 -0.5
En2 dn1 0 vb 0 1
Vb vb 0 2.3
Xm1 ldk dp me q
Xm2 dumm dn me q
Rdm v5 dumm 25
* BEN steering (LVTTL through dividers, on 1.65 V / off 1.25 V against 1.45 V)
Vben ben 0 PULSE(0 3.3 2n 1n 1n 1.2u 3u)
Ra ben bon 1k
Rb v33 bon 320
Rc bon 0 242
Rr1 v33 bref 300
Rr2 bref 0 240
Xs1 me bon mt q
Xs2 dums bref mt q
Rds v5 dums 25
Xb1 bc bon bt q
Rbs bc ldk 10
Xb2 dumb bref bt q
Rdb v5 dumb 25
* tails: op-amp regulated current sinks (ideal loop), emitter 10 ohm
Xmt mt mtb mte q
Rme mte 0 10
Bmt mtx 0 V=max(0,min(3.3,1000*({imod*10}-v(mte))))
Rmt mtx mtb 100
Cmt mtb 0 1n
Xbt bt btb bte q
Rbe bte 0 10
Bbt btx 0 V=max(0,min(3.3,1000*({ibias*10}-v(bte))))
Rbt btx btb 100
Cbt btb 0 1n
.tran 5p 3.3u 0 5p
.control
run
let il = -i(V5)
meas tran ion  when i(Lla)=30m rise=1
meas tran ben_on when v(ben)=1.65 rise=1
let lon = ion - ben_on
meas tran ioff when i(Lla)=10m fall=last
meas tran ben_off when v(ben)=1.65 fall=1
let loff = ioff - ben_off
print lon loff
meas tran vce_min_m1 min v(ldk)
meas tran vme max v(me)
meas tran vmt min v(mt)
meas tran vbt min v(bt)
meas tran ilmax max i(Lla) from=100n to=1.1u
meas tran ilmin min i(Lla) from=100n to=1.1u
wrdata laser.txt i(Lla) v(ben) v(bc) v(me) v(ldk) v(la) v(lk) v(mt) v(bt)
.endc
.end
